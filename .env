MAX_RETRY=10
RETRY_WAIT_SECONDS=20

CHAT_AZURE_API_BASE=https://your-resource.openai.azure.com/
CHAT_AZURE_API_VERSION=2025-01-01-preview
AZURE_API_KEY=your-azure-api-key
CHAT_MODEL=gpt-4o

EMBEDDING_AZURE_API_BASE=https://your-resource.openai.azure.com/
EMBEDDING_AZURE_API_VERSION=2025-01-01-preview
EMBEDDING_MODEL=text-embedding-3-small

USE_CHAT_CACHE=True
USE_EMBEDDING_CACHE=True
