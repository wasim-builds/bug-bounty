# Environment configuration template.
# Copy this file to .env and fill in your real values. Never commit .env.

# Retry behaviour for scanner/request wrappers
MAX_RETRY=3
RETRY_WAIT_SECONDS=2

# Azure OpenAI (chat) endpoints
CHAT_AZURE_API_BASE=https://<your-resource>.openai.azure.com/
CHAT_AZURE_API_VERSION=2024-05-01-preview
AZURE_API_KEY=

# Model names
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (embeddings) endpoints
EMBEDDING_AZURE_API_BASE=https://<your-resource>.openai.azure.com/
EMBEDDING_AZURE_API_VERSION=2024-05-01-preview

# Caching toggles
USE_CHAT_CACHE=true
USE_EMBEDDING_CACHE=true
